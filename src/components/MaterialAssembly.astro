---
// «Fabricamos tu producto»: cuatro materiales se juntan, se vuelven piezas en vista
// explotada y el scroll las arma en una caja terminada.
import AssemblyStage from "./AssemblyStage.astro";
import art from "../assets/art/materiales.svg?url";
---

<AssemblyStage
  id="assembly-wrap"
  eyebrow="Del taller"
  titleId="assembly-title"
  sub="Acrílico, MDF, papel y filamento — en serie."
  hint="Materiales sueltos"
  src={art}
  width={640}
  height={560}
>
  Fabricamos tu <em>producto.</em>
</AssemblyStage>

<script>
  import { assembly, clamp, ease, projector } from "../scripts/assembly";

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  assembly({
    id: "assembly-wrap",
    stages: [["Materiales sueltos", 0.4], ["Ensamblando", 0.8], ["Pieza terminada", 2]],
    setup(svg) {
      const place = projector(svg);
      const [cx, cy] = (svg.dataset.center as string).split(",").map(Number);
      const [width, height] = (svg.dataset.size as string).split(",").map(Number);
      const maxZoom = Number(svg.dataset.zoom);
      const camera = svg.querySelector("[data-zoom]") as SVGGElement;
      const mats = Array.from(svg.querySelectorAll<SVGGElement>("[data-mat]")).map((el) => {
        const [x, y, rotate] = (el.dataset.mat as string).split(",").map(Number);
        return { el, x, y, rotate };
      });
      const parts = Array.from(svg.querySelectorAll<SVGGElement>("[data-part]")).map((el) => {
        const [dx, dy, dz] = (el.dataset.from as string).split(",").map(Number);
        return { el, order: Number(el.dataset.part), dx, dy, dz };
      });
      const guides = svg.querySelector("[data-guides]") as SVGPathElement;
      const shadow = svg.querySelector("[data-shadow]") as SVGEllipseElement;
      const shine = svg.querySelector("[data-shine]") as SVGPathElement;

      return (p) => {
        const gather = ease(clamp(p / 0.6));
        const visible = 1 - clamp((p - 0.38) / 0.2);
        mats.forEach(({ el, x, y, rotate }) => {
          el.style.display = visible > 0 ? "" : "none";
          if (visible > 0) {
            el.style.opacity = String(visible);
            el.style.transform = `translate(${lerp(x, cx, gather)}px, ${lerp(y, cy, gather)}px) rotate(${rotate * (1 - gather)}deg) scale(${1 - 0.55 * gather})`;
          }
        });

        const push = ease(clamp((p - 0.62) / 0.3));
        camera.style.transform = `translate(${lerp(cx, width / 2, push)}px, ${lerp(cy, height / 2, push)}px) scale(${lerp(1, maxZoom, push)}) translate(${-cx}px, ${-cy}px)`;

        parts.forEach(({ el, order, dx, dy, dz }) => {
          const left = 1 - ease(clamp((p - (0.46 + order * 0.035)) / 0.2));
          place(el, dx * left, dy * left, dz * left);
          el.style.opacity = String(clamp((p - 0.36 - order * 0.012) / 0.08));
        });

        guides.setAttribute("opacity", String(0.55 * clamp((p - 0.42) / 0.08) * (1 - clamp((p - 0.72) / 0.12))));
        shadow.setAttribute("opacity", String(clamp((p - 0.5) / 0.3)));
        const sweep = clamp((p - 0.88) / 0.1);
        shine.setAttribute("opacity", sweep > 0 && sweep < 1 ? "1" : "0");
        shine.setAttribute("transform", `translate(${-220 + 440 * sweep} 0)`);
      };
    },
  });
</script>
