---
// 3D printing hero showcase — 3 printed pieces growing layer by layer.
import LazyArt from "./LazyArt.astro";
import florero from "../assets/art/pieza-florero.svg?url";
import engrane from "../assets/art/pieza-engrane.svg?url";
import maqueta from "../assets/art/pieza-maqueta.svg?url";
---

<div class="hero-stack">
  <div class="hero-card hero-card--back">
    <LazyArt src={engrane} width={320} height={320} />
  </div>
  <div class="hero-card hero-card--main">
    <LazyArt src={florero} alt="Florero multicolor imprimiéndose capa por capa en una impresora 3D" width={320} height={400} />
  </div>
  <div class="hero-card hero-card--front">
    <LazyArt src={maqueta} width={320} height={320} />
  </div>
</div>

<style>
  .hero-stack {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-card {
    position: absolute;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 24px 56px rgba(20, 10, 4, 0.22),
      0 0 0 1px rgba(165, 58, 4, 0.06);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }


  /* La pieza crece desde abajo: las otras dos tarjetas solo pisan la orilla derecha. */
  .hero-card--main {
    width: 62%;
    aspect-ratio: 4 / 5;
    top: 9%;
    left: 0;
    z-index: 3;
    transform: rotate(-2deg);
  }

  .hero-card--back {
    width: 44%;
    aspect-ratio: 1 / 1;
    top: 0;
    right: 0;
    z-index: 1;
    transform: rotate(6deg);
    opacity: 0.96;
  }

  .hero-card--front {
    width: 46%;
    aspect-ratio: 1 / 1;
    bottom: 0;
    right: 2%;
    z-index: 4;
    transform: rotate(-4deg);
  }

  .hero-stack:hover .hero-card--main { transform: rotate(-1deg) translateY(-4px); }
  .hero-stack:hover .hero-card--back { transform: rotate(8deg) translateX(4px); }
  .hero-stack:hover .hero-card--front { transform: rotate(-5deg) translate(4px, 4px); }
</style>
