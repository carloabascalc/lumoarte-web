---
// «Capa por capa»: el scroll imprime un florero. Primero se ve el modelo digital,
// luego las capas lo van llenando con la boquilla caminando sobre el borde.
import AssemblyStage from "./AssemblyStage.astro";
import art from "../assets/art/tresd-proceso.svg?url";
---

<AssemblyStage
  id="tresd-assembly-wrap"
  eyebrow="Cómo se imprime"
  titleId="tresd-assembly-title"
  sub="La pieza crece en cientos de capas finas. Cada milímetro suma — y cuando termina, ya no hay vuelta atrás."
  hint="Modelo digital"
  src={art}
  width={560}
  height={640}
>
  Capa por capa, <br/>hasta la <em>pieza.</em>
</AssemblyStage>

<script>
  import { assembly, clamp, ease, projector } from "../scripts/assembly";

  const PRINT_START = 0.12;
  const PRINT_END = 0.85;
  const TURNS = 14;
  // La boquilla arranca por el frente del florero, donde se ve llegar.
  const START_ANGLE = -1.15;

  assembly({
    id: "tresd-assembly-wrap",
    stages: [["Modelo digital", PRINT_START], ["Imprimiendo", PRINT_END], ["Pieza física", 2]],
    setup(svg) {
      const place = projector(svg);
      const layers = Array.from(svg.querySelectorAll<SVGGElement>("[data-layer]"));
      const head = svg.querySelector("[data-head]") as SVGGElement;
      const rail = svg.querySelector("[data-rail]") as SVGGElement;
      const wire = svg.querySelector("[data-wire]") as SVGGElement;
      const glow = svg.querySelector("[data-glow]") as SVGCircleElement;
      const shine = svg.querySelector("[data-shine]") as SVGPathElement;
      const radii = (svg.dataset.radii as string).split(",").map(Number);
      const layerH = Number(svg.dataset.h);
      const [px, py, pz] = (svg.dataset.park as string).split(",").map(Number);
      const N = layers.length;
      let shown = N;

      return (p) => {
        const u = clamp((p - PRINT_START) / (PRINT_END - PRINT_START));
        const count = Math.round(u * N);
        if (count !== shown) {
          for (let i = Math.min(count, shown); i < Math.max(count, shown); i++) {
            layers[i].style.display = i < count ? "" : "none";
          }
          shown = count;
        }

        const z = count * layerH;
        const r = radii[Math.min(count, N - 1)];
        const angle = START_ANGLE + u * TURNS * Math.PI * 2;
        const onRim = [r * Math.cos(angle), r * Math.sin(angle), z];
        // Entra desde su lugar de reposo y regresa ahí al terminar.
        const away = p < PRINT_START ? 1 - ease(clamp(p / PRINT_START)) : ease(clamp((p - PRINT_END) / 0.1));
        const at = (a: number, b: number) => a + (b - a) * away;
        place(head, at(onRim[0], px), at(onRim[1], py), at(onRim[2], pz));
        place(rail, 0, 0, at(onRim[2], pz));
        glow.setAttribute("opacity", p > PRINT_START && p < PRINT_END ? "1" : "0");
        wire.setAttribute("opacity", String(1 - clamp((p - PRINT_END) / 0.05)));
        const sweep = clamp((p - 0.88) / 0.1);
        shine.setAttribute("opacity", sweep > 0 && sweep < 1 ? "1" : "0");
        shine.setAttribute("transform", `translate(${-140 + 280 * sweep} 0)`);
      };
    },
  });
</script>
