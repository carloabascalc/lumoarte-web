---
// Homepage "Para quién fabricamos" — one card per volume segment, each
// linking to its /sectores/* landing page. Photos are real shop work.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { segments } from "../data/segments";
import { segmentImage, segmentAlt } from "../data/segmentImages";

interface Props {
  /** Hide the current segment when used on a sector page. */
  excludeId?: string;
  title?: string;
  subtitle?: string;
}
const {
  excludeId,
  title = "Para quién fabricamos",
  subtitle = "Producimos en serie para negocios que necesitan la misma pieza muchas veces — y que vuelven a pedirla.",
} = Astro.props;

const items = segments
  .filter((s) => s.id !== excludeId)
  .map((s) => ({ ...s, img: segmentImage(s.cardImage) as ImageMetadata, alt: segmentAlt(s.cardImage) }));
---

<section class="sectors section" id="sectores">
  <div class="container">
    <div class="section-header">
      <p class="sectors-eyebrow" data-reveal>Sectores</p>
      <h2 class="section-title" data-reveal data-reveal-delay="0.06">{title}</h2>
      <p class="section-subtitle" data-reveal data-reveal-delay="0.12">{subtitle}</p>
    </div>

    <ul class:list={["sectors-grid", { "sectors-grid--three": items.length === 3 }]} role="list">
      {items.map((s, i) => (
        <li class="sector" data-reveal data-reveal-delay={`${0.04 + i * 0.05}`}>
          <a class="sector-link" href={s.slug}>
            <div class="sector-media">
              <Image
                src={s.img}
                alt={s.alt}
                widths={[360, 540]}
                sizes="(max-width: 640px) 100vw, 300px"
                quality={75}
                loading="lazy"
                decoding="async"
                class="sector-img"
              />
              <span class="sector-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="sector-body">
              <h3 class="sector-title">{s.name}</h3>
              <p class="sector-blurb">{s.blurb}</p>
              <span class="sector-cta">
                Ver más
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sectors {
    background: var(--color-bg-alt);
  }

  .sectors-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    list-style: none;
  }

  .sectors-grid--three {
    grid-template-columns: repeat(3, 1fr);
  }

  .sector-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-surface);
    border-radius: 10px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .sector-link:hover {
    transform: translateY(-4px);
    border-color: rgba(165, 58, 4, 0.25);
    box-shadow: 0 18px 40px rgba(20, 10, 4, 0.10);
  }

  .sector-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .sector-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .sector-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sector-link:hover .sector-img {
    transform: scale(1.04);
  }

  .sector-num {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: #fff;
    background: rgba(15, 15, 15, 0.55);
    padding: 3px 10px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .sector-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 24px;
    flex: 1;
  }

  .sector-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
  }

  .sector-blurb {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1;
  }

  .sector-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .sector-cta svg {
    transition: transform 0.25s ease;
  }

  .sector-link:hover .sector-cta svg {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .sectors-grid,
    .sectors-grid--three {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .sectors-grid,
    .sectors-grid--three {
      grid-template-columns: 1fr;
    }

    .sector-media {
      aspect-ratio: 16 / 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-link,
    .sector-img,
    .sector-cta svg {
      transition: none;
    }
    .sector-link:hover,
    .sector-link:hover .sector-img {
      transform: none;
    }
  }
</style>
