---
// Ilustración animada generada por tools/printer_art.py o tools/site_art.py.
// Pesan decenas de KB: se descargan al acercarse y solo se animan mientras están a la vista.
interface Props {
  src: string;
  /** Vacío = decorativa, los lectores de pantalla la ignoran. */
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}
const { src, alt = "", width = 480, height = 360, class: className, ...rest } = Astro.props;
const a11y = alt ? { role: "img", "aria-label": alt } : { "aria-hidden": "true" };
---

<div class:list={["lazy-art", className]} data-lazy-art={src} {...a11y} {...rest}>
  <noscript><img src={src} alt="" width={width} height={height} /></noscript>
</div>

<style>
  .lazy-art {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: linear-gradient(#f8f2e7, #ece1cf);
  }

  .lazy-art :global(svg),
  .lazy-art img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lazy-art :global(svg) {
    animation: lazy-art-in 0.45s ease-out;
  }

  @keyframes lazy-art-in {
    from { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lazy-art :global(svg) { animation: none; }
  }
</style>

<script>
  const watch = () => {
    const arts = document.querySelectorAll<HTMLElement>("[data-lazy-art]");
    if (!arts.length) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        el.style.setProperty("--play", e.isIntersecting ? "running" : "paused");
        if (e.isIntersecting && !el.dataset.loaded) {
          el.dataset.loaded = "true";
          fetch(el.dataset.lazyArt as string).then((r) => r.text()).then((svg) => {
            el.innerHTML = svg;
            el.dispatchEvent(new CustomEvent("lazy-art:loaded"));
          });
        }
      }
    }, { rootMargin: "400px" });
    arts.forEach((el) => io.observe(el));
  };
  document.addEventListener("astro:page-load", watch);
</script>
