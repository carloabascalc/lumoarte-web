---
// El proceso de corte, contado con el scroll: la cortadora CO₂ generada por
// tools/printer_art.py corta una hoja de MDF en una serie de doce piezas y al final
// las piezas se levantan. El scroll fija el tiempo de su animación CSS (--t).
import LazyMachineSvg from "./LazyMachineSvg.astro";
import laserSvg from "../assets/printers/laser.svg?url";
---

<section class="laser-assembly assembly" aria-labelledby="laser-assembly-title">
  <div class="container assembly-header">
    <p class="assembly-eyebrow">El proceso</p>
    <h2 class="assembly-title section-title" id="laser-assembly-title">
      De la lámina<br/>a la <em>serie.</em>
    </h2>
    <p class="assembly-sub">
      El láser sigue la línea pieza por pieza: una hoja de MDF se
      convierte en un lote de piezas idénticas, listas para tu negocio.
    </p>
  </div>

  <div class="assembly-wrap" id="laser-assembly-wrap">
    <div class="assembly-stage" id="laser-assembly-stage">
      <div class="assembly-grid-bg" aria-hidden="true"></div>

      <div class="laser-canvas">
        <LazyMachineSvg src={laserSvg} width={640} height={480} scrub id="laser-machine" />
      </div>

      <p class="assembly-hint" aria-hidden="true">
        <span id="laser-hint-label">Lámina entera</span>
        <b id="laser-hint-stage">01</b><span class="assembly-hint-of"> / 03</span>
      </p>
    </div>
  </div>
</section>

<style>
  .laser-assembly {
    background: var(--color-bg);
    position: relative;
    padding-top: 120px;
  }

  .assembly-wrap {
    position: relative;
    height: 240vh;
    contain: layout paint;
  }

  .assembly-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* --stage-top: alto del nav + barras fijas de la página (lo mide el script). */
    padding: var(--stage-top, var(--nav-h)) 0 56px;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .assembly-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(20, 10, 4, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 10, 4, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0;
    will-change: opacity;
    pointer-events: none;
  }

  .assembly-header {
    position: relative;
    z-index: 4;
    text-align: center;
  }

  .assembly-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .assembly-title { margin-bottom: 18px; }
  .assembly-title em { font-style: italic; color: var(--color-accent); }

  .assembly-sub {
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto;
  }

  .laser-canvas {
    position: relative;
    z-index: 2;
    width: min(620px, 92vw, calc((100vh - var(--stage-top, var(--nav-h)) - 96px) * 4 / 3));
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 22px 48px rgba(20, 10, 4, 0.10);
  }

  .assembly-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    white-space: nowrap;
  }

  .assembly-hint b {
    color: var(--color-accent);
    font-weight: 600;
    transition: color 0.3s ease;
    font-variant-numeric: tabular-nums;
  }

  .assembly-hint-of { color: var(--color-muted); opacity: 0.6; }

  @media (max-width: 640px) {
    .laser-assembly { padding-top: 80px; }
    .assembly-wrap { height: 220vh; }
    .assembly-sub { font-size: 0.95rem; max-width: 320px; }
    .assembly-hint { font-size: 0.66rem; letter-spacing: 0.14em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .assembly-wrap { height: auto; }
    .assembly-stage { position: static; height: auto; padding: 48px 0 100px; }
    .assembly-hint { display: none; }
  }
</style>

<script>
  // Tiempos del ciclo de laser() en tools/printer_art.py (segundos).
  const T_SHEET = 0.9;  // hoja entera, aún sin cortar
  const T_START = 1.2;  // empieza el primer corte
  const T_DONE = 18.0;  // termina el corte número doce
  const T_LIFT = 20.2;  // piezas levantadas

  function initLaserAssembly() {
    const wrap = document.getElementById('laser-assembly-wrap');
    const stage = document.getElementById('laser-assembly-stage');
    const machine = document.getElementById('laser-machine');
    const grid = wrap?.querySelector<HTMLElement>('.assembly-grid-bg');
    const hintLabel = document.getElementById('laser-hint-label');
    const hintStage = document.getElementById('laser-hint-stage');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!wrap || !machine || reduced) return;

    const cutsStart = 0.05;
    const liftStart = 0.62;
    const liftEnd = 0.96;

    const clamp = (v: number, lo = 0, hi = 1) => Math.max(lo, Math.min(hi, v));
    const lerp = (a: number, b: number, k: number) => a + (b - a) * clamp(k);

    // Las barras fijas (nav y, en páginas de servicio, la barra de PDFs) tapan la parte de
    // arriba de la escena; la máquina se centra en lo que queda visible.
    function measure() {
      const bar = document.querySelector<HTMLElement>('.service-pdfs');
      let top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 72;
      if (bar && getComputedStyle(bar).position === 'sticky') {
        top = (parseFloat(getComputedStyle(bar).top) || 0) + bar.offsetHeight;
      }
      stage?.style.setProperty('--stage-top', `${Math.round(top)}px`);
    }

    let pending = false;

    function tick() {
      pending = false;
      const rect = wrap!.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      if (total <= 0) return;
      const p = clamp(-rect.top / total);

      if (grid) {
        const o = p < 0.35 ? (p / 0.35) * 0.5
                : p < 0.92 ? 0.5 - ((p - 0.35) / 0.57) * 0.4
                : Math.max(0, 0.1 - ((p - 0.92) / 0.08) * 0.1);
        grid.style.opacity = String(o);
      }

      let t: number;
      if (p < cutsStart) t = lerp(T_SHEET, T_START, p / cutsStart);
      else if (p < liftStart) t = lerp(T_START, T_DONE, (p - cutsStart) / (liftStart - cutsStart));
      else t = lerp(T_DONE, T_LIFT, (p - liftStart) / (liftEnd - liftStart));
      machine!.style.setProperty('--t', `-${t.toFixed(3)}s`);

      if (hintLabel && hintStage) {
        if (p < cutsStart) { hintLabel.textContent = 'Lámina entera'; hintStage.textContent = '01'; }
        else if (p < liftStart) { hintLabel.textContent = 'Cortando'; hintStage.textContent = '02'; }
        else { hintLabel.textContent = 'Piezas listas'; hintStage.textContent = '03'; }
      }
    }

    function onScroll() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(tick);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { measure(); onScroll(); }, { passive: true });
    measure();
    tick();
  }

  initLaserAssembly();
  document.addEventListener('astro:page-load', initLaserAssembly);
</script>
