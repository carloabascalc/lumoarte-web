---
// «De la lámina a la celosía»: el scroll lleva el pórtico sobre la lámina, el láser
// corta cada hexágono y las piezas salen de su hueco hacia la charola.
import AssemblyStage from "./AssemblyStage.astro";
import art from "../assets/art/laser-proceso.svg?url";
---

<AssemblyStage
  id="laser-assembly-wrap"
  eyebrow="El proceso"
  titleId="laser-assembly-title"
  sub="El láser sigue la línea, el material se separa, los cortes se vuelven patrón. Una pieza arquitectónica, hecha del calor que traza un haz de luz."
  hint="Lámina entera"
  src={art}
  width={640}
  height={556}
  scroll="240vh"
  scrollMobile="220vh"
>
  De la lámina<br/>a la <em>celosía.</em>
</AssemblyStage>

<script>
  import { assembly, clamp, ease, projector } from "../scripts/assembly";

  const CUT_START = 0.07;
  const CUT_END = 0.6;
  const LIFT_START = 0.64;
  const LIFT_END = 0.98;
  // Parte del turno de cada hexágono con el láser encendido; el resto es traslado.
  const BURN = 0.8;
  const FLIGHT = 0.1;
  const HOVER = 150;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const pairs = (text: string) => text.split(" ").map((pair) => pair.split(",").map(Number));

  assembly({
    id: "laser-assembly-wrap",
    stages: [["Lámina entera", CUT_START], ["Cortando", LIFT_START], ["Piezas listas", 2]],
    setup(svg) {
      const place = projector(svg);
      const all = <T extends SVGElement>(selector: string) => Array.from(svg.querySelectorAll<T>(selector));
      const one = (selector: string) => svg.querySelector(selector) as SVGGElement;
      const show = (el: SVGElement, on: boolean) => {
        el.style.display = on ? "" : "none";
      };

      const cuts = all<SVGPathElement>("[data-cut]");
      const holes = all<SVGGElement>("[data-hole]");
      const pieces = all<SVGGElement>("[data-piece]");
      const gantry = one("[data-gantry]");
      const gantryShadow = one("[data-gantry-shadow]");
      const head = one("[data-head]");
      const tip = one("[data-tip]");
      const hot = svg.querySelector("[data-hot]") as SVGPathElement;

      const hexagon = pairs(svg.dataset.hex as string);
      // Los lados no miden lo mismo en pantalla: esto traduce vuelta del cabezal a avance del trazo.
      const screenShare = (svg.dataset.fr as string).split(",").map(Number);
      const [parkX, parkY] = (svg.dataset.park as string).split(",").map(Number);
      const centers = cuts.map((cut) => (cut.dataset.c as string).split(",").map(Number));
      const targets = pieces.map((piece) => (piece.dataset.to as string).split(",").map(Number));
      const N = cuts.length;
      const turn = (CUT_END - CUT_START) / N;
      const liftGap = (LIFT_END - LIFT_START - FLIGHT) / (N - 1);

      const corner = (k: number, i: number) => {
        const [vx, vy] = hexagon[i % 6];
        return [centers[k][0] + vx, centers[k][1] + vy];
      };

      let drawnOn = -1;

      return (p) => {
        let x = parkX;
        let y = parkY;
        let done = N;
        let active = -1;
        let share = 0;

        if (p < CUT_START) {
          const t = ease(clamp(p / CUT_START));
          const [sx, sy] = corner(0, 0);
          x = lerp(parkX, sx, t);
          y = lerp(parkY, sy, t);
          done = 0;
        } else if (p < CUT_END) {
          const progress = (p - CUT_START) / turn;
          const k = Math.floor(progress);
          const within = progress - k;
          if (within < BURN) {
            const around = (within / BURN) * 6;
            const side = Math.floor(around);
            const [ax, ay] = corner(k, side);
            const [bx, by] = corner(k, side + 1);
            x = lerp(ax, bx, around - side);
            y = lerp(ay, by, around - side);
            share = lerp(screenShare[side], screenShare[side + 1], around - side);
            active = k;
            done = k;
          } else {
            const t = ease((within - BURN) / (1 - BURN));
            const [ax, ay] = corner(k, 0);
            const [bx, by] = corner(Math.min(k + 1, N - 1), 0);
            x = lerp(ax, bx, t);
            y = lerp(ay, by, t);
            done = k + 1;
          }
        } else {
          const t = ease(clamp((p - CUT_END) / (LIFT_START - CUT_END)));
          const [sx, sy] = corner(N - 1, 0);
          x = lerp(sx, parkX, t);
          y = lerp(sy, parkY, t);
        }

        place(gantry, 0, y - parkY, 0);
        place(gantryShadow, 0, y - parkY, 0);
        place(head, x - parkX, 0, 0);
        show(tip, active >= 0);
        show(hot, active >= 0);

        cuts.forEach((cut, k) => {
          const left = k < done ? 0 : k === active ? 1 - share : 1;
          cut.style.strokeDashoffset = String(left * 100);
        });
        if (active >= 0) {
          if (drawnOn !== active) {
            hot.setAttribute("d", cuts[active].getAttribute("d") as string);
            drawnOn = active;
          }
          hot.style.strokeDashoffset = String(9 - share * 100);
        }

        pieces.forEach((piece, k) => {
          const e = clamp((p - (LIFT_START + k * liftGap)) / FLIGHT);
          show(piece, e > 0);
          show(holes[k], e > 0);
          if (e > 0) {
            const [tx, ty, tz] = targets[k];
            const travel = ease(clamp((e - 0.18) / 0.72));
            const land = ease(clamp((e - 0.55) / 0.45));
            const rise = ease(clamp(e / 0.3));
            place(piece, tx * travel, ty * travel, HOVER * rise * (1 - land) + tz * land);
          }
        });
      };
    },
  });
</script>
