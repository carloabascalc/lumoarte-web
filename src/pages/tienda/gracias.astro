---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Footer from "../../components/Footer.astro";
import { SITE } from "../../data/services";
---

<Base
  title="Gracias por tu pedido | Tienda Lumo Cancún"
  description="Tu pedido de la tienda de Lumo Cancún quedó listo para confirmarse por WhatsApp."
  canonical="/tienda/gracias/"
  pageAccent="3d"
  noindex
>
  <Nav variant="solid" ctaHref="/#cotiza" />
  <main>
    <Breadcrumb items={[{ label: "Inicio", href: "/" }, { label: "Tienda", href: "/tienda/" }, { label: "Gracias" }]} />
    <section class="thanks">
      <div class="container">
        <h1 class="thanks-title">Confirma tu pedido en WhatsApp</h1>
        <p class="thanks-p">
          Abrimos WhatsApp con el resumen de tu pedido. <strong>Envía ese mensaje</strong> para
          confirmarlo: te respondemos con la existencia y la liga de pago.
        </p>
        <p class="thanks-p">
          ¿No se abrió? Vuelve a intentarlo o escríbenos al {SITE.whatsappDisplay}.
        </p>
        <div class="thanks-actions">
          <a
            class="btn btn-primary"
            data-reopen
            href={`https://wa.me/${SITE.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
          >Abrir WhatsApp</a>
          <a class="btn btn-outline" href="/tienda/">Volver a la tienda</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  function bootThanks() {
    const link = document.querySelector<HTMLAnchorElement>("[data-reopen]");
    if (!link) return;
    try {
      const url = sessionStorage.getItem("lumo-last-order");
      if (url?.startsWith("https://wa.me/")) link.href = url;
    } catch {
      // Sin almacenamiento el botón abre el chat sin el resumen.
    }
  }
  bootThanks();
  document.addEventListener("astro:page-load", bootThanks);
</script>

<style>
  .thanks {
    padding: 56px 0 120px;
    min-height: 55vh;
  }

  .thanks-title {
    font-size: clamp(2rem, 5vw, 3rem);
    max-width: 20ch;
    margin-bottom: 24px;
  }

  .thanks-p {
    max-width: 58ch;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .thanks-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
