---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ServicePageHero from "../components/ServicePageHero.astro";
import LaserShowcase from "../components/LaserShowcase.astro";
import LaserAssembly from "../components/LaserAssembly.astro";
import Materials from "../components/Materials.astro";
import Gallery from "../components/Gallery.astro";
import FAQ from "../components/FAQ.astro";
import InstagramCTA from "../components/InstagramCTA.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getService, EMD_ENABLED } from "../data/services";

const service = getService("corte-laser");
const emdUrl = `https://${service.emdDomain}`;
// Dormant: while the EMD domain isn't registered, hide this page from search.
const noindex = !EMD_ENABLED;

const sectores = [
  {
    label: "Hoteles y restaurantes",
    description:
      "Posavasos, menús, llaveros de habitación, señalética y amenidades grabadas con tu marca — en lotes y con reposición.",
  },
  {
    label: "Marcas y corporativos",
    description:
      "Regalos corporativos, placas, reconocimientos, kits de bienvenida y displays con el logo de tu empresa, por cientos.",
  },
  {
    label: "Tiendas de souvenirs y mayoreo",
    description:
      "Llaveros, imanes y recuerdos de Cancún fabricados por lote para tiendas, hoteles y revendedores.",
  },
  {
    label: "Eventos y bodas",
    description:
      "Números de mesa, recuerdos, señalética y decoración para eventos de cientos de invitados, iguales pieza a pieza.",
  },
  {
    label: "Retail y señalética",
    description:
      "Señalética interior, displays, exhibidores y lettering volumétrico para sucursales y puntos de venta.",
  },
  {
    label: "Líneas de producto",
    description:
      "Si vendes un producto cortado o grabado, lo fabricamos para ti en serie — cajas, empaques, kits y piezas de línea.",
  },
];

const serviceSchema = {
  name: "Corte láser en Cancún",
  serviceType: "Laser cutting and engraving",
  description: service.metaDescription,
  url: `${emdUrl}/`,
};

const faqs = [
  {
    question: "¿Cuánto tarda un trabajo de corte láser?",
    answer:
      "Habitualmente menos de una semana; cuando hay disponibilidad, el mismo día. Las producciones grandes las calendarizamos contigo al cotizar, según cantidad y material. Si tu fecha es fija, dila en la cotización.",
  },
  {
    question: "¿Qué tipo de archivo necesito enviar?",
    answer:
      "Trabajamos con vectores en formato AI, EPS, SVG, PDF o DXF. Si solo tienes una imagen JPG o PNG nítida, podemos vectorizarla por ti — incluido en la cotización si no es muy compleja. Lo importante es que las líneas estén limpias y la escala sea la real (en milímetros o centímetros).",
  },
  {
    question: "¿Cuál es el tamaño máximo de corte?",
    answer:
      "El área útil de nuestra máquina es de 130 × 90 cm en una sola pieza. Para piezas más grandes, las dividimos en módulos que ensamblan invisiblemente — así hemos hecho paneles y celosías de varios metros.",
  },
  {
    question: "¿Hacen producción en serie o por volumen?",
    answer:
      "Sí, es nuestro fuerte. Cortamos y grabamos lotes de decenas a miles de piezas idénticas: llaveros, posavasos, placas, cajas, señalética y regalos corporativos con logo. El costo por pieza baja conforme sube la cantidad, porque el material se aprovecha mejor y la máquina trabaja en corridas continuas. Guardamos tu archivo para que reponer sea un solo mensaje.",
  },
  {
    question: "¿Son carpintería? ¿Hacen muebles?",
    answer:
      "No. Somos un taller de fabricación digital: cortamos y grabamos con láser láminas de MDF, triplay, acrílico, cuero y otros materiales a partir de un archivo. No fabricamos muebles ni hacemos trabajos de carpintería.",
  },
  {
    question: "¿Hacen entrega o envíos?",
    answer:
      "En Cancún hacemos entrega a domicilio dentro de la zona metropolitana con costo según ubicación. Para Playa del Carmen, Tulum, Mérida y otras ciudades enviamos por paquetería (DHL, Estafeta) — el costo lo agregamos a la cotización. También puedes recoger en el taller en Retorno Tejón, Supermanzana 20.",
  },
  {
    question: "¿Cómo pago?",
    answer:
      "Aceptamos transferencia bancaria, depósito en efectivo, tarjeta de débito y crédito (con pequeño cargo bancario). Para producciones grandes pedimos 50% de anticipo y 50% al entregar. Para trabajos pequeños el pago es completo al confirmar.",
  },
];
---

<Base
  title="Corte láser en serie en Cancún | Lumo Cancún"
  description="Corte láser y grabado en serie en Cancún para hoteles, restaurantes, marcas y tiendas. Acrílico, MDF, cuero, vidrio, mármol. Precio por volumen, cotización por WhatsApp."
  canonical={EMD_ENABLED ? `${emdUrl}/` : service.slug}
  ogImage="/og/corte-laser.jpg"
  schemaType="Service"
  schemaData={serviceSchema}
  noindex={noindex}
>
  <Nav variant="emd" emdService="corte-laser" />
  <main>
    <ServicePageHero
      eyebrow="Corte láser en Cancún"
      title="Corte láser en serie en <em>Cancún</em>"
      subtitle="Cortamos y grabamos en serie para hoteles, restaurantes, marcas, tiendas y eventos. Lotes de decenas a miles de piezas idénticas, con precio por volumen."
      primaryCta={{ label: "Cotiza tu producción", href: "#cotiza" }}
      secondaryCta={{ label: "Ver materiales", href: "#materiales" }}
      service="laser"
    >
      <LaserShowcase slot="showcase" />
    </ServicePageHero>

    <LaserAssembly />

    <Materials />

    <section class="sectores section">
      <div class="container">
        <div class="section-header">
          <p class="sectores-eyebrow" data-reveal>Para quién trabajamos</p>
          <h2 class="section-title" data-reveal data-reveal-delay="0.06">
            Negocios que producen con nosotros
          </h2>
          <p class="section-subtitle" data-reveal data-reveal-delay="0.12">
            Fabricamos en serie para negocios que necesitan la misma pieza
            muchas veces — y que vuelven a pedirla.
          </p>
        </div>
        <ul class="sectores-grid" role="list">
          {sectores.map((s, i) => (
            <li class="sector-card" data-reveal data-reveal-delay={`${0.04 + i * 0.04}`}>
              <h3 class="sector-name">{s.label}</h3>
              <p class="sector-description">{s.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Gallery
      filterService="corte-laser"
      title="Trabajos de corte láser"
      subtitle="Una selección del taller — productos terminados, lifestyle y trabajos a escala industrial."
    />

    <InstagramCTA />

    <FAQ
      title="Preguntas frecuentes sobre corte láser"
      subtitle="Las dudas que nos hacen más seguido. Si la tuya no aparece, mándanos un WhatsApp."
      items={faqs}
    />

    <QuoteForm defaultService="corte-laser" />
  </main>
  <div class="page-end">
    <Contact />
    <Footer variant="minimal" />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .sectores {
    background: var(--color-bg-alt);
  }

  .sectores-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .sectores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    overflow: hidden;
  }

  @media (max-width: 880px) {
    .sectores-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .sectores-grid {
      grid-template-columns: 1fr;
    }
  }

  .sector-card {
    background: var(--color-bg);
    padding: 36px 32px;
    transition: background 0.25s ease;
  }

  .sector-card:hover {
    background: #fff;
  }

  .sector-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .sector-description {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .sector-card {
      padding: 28px 24px;
    }
  }
</style>
