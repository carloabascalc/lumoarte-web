---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { SITE } from "../data/services";
import { RATING_LABELS, SURVEY } from "../data/feedback";

const starPath =
  "M12 2.6l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z";
---

<Base
  title="Califica tu pedido · Lumo Cancún"
  description="¿Cómo te fue con tu pedido de corte láser o impresión 3D en Lumo Cancún? Califícanos en un minuto: tu opinión nos ayuda a mejorar."
  noindex
>
  <Nav variant="solid" ctaHref="/#cotiza" />
  <main
    class="rate"
    id="rate"
    data-wa={SITE.whatsapp}
    data-labels={JSON.stringify(RATING_LABELS)}
  >
    <div class="container rate-inner">
      <!-- 1 · Estrellas -->
      <section class="rate-step" data-step="stars" aria-labelledby="rate-title">
        <p class="rate-eyebrow">Tu opinión</p>
        <h1 class="rate-title" id="rate-title" tabindex="-1">¿Cómo te fue con tu pedido?</h1>
        <p class="rate-lead">
          Toca las estrellas. Es menos de un minuto y nos ayuda muchísimo.
        </p>

        <fieldset class="stars-field">
          <legend class="visually-hidden">Califica tu pedido de 1 a 5 estrellas</legend>
          <div class="stars" data-fill="0">
            {RATING_LABELS.map((label, i) => (
              <label class="star">
                <input type="radio" name="estrellas" value={i + 1} />
                <span class="visually-hidden">{i + 1} {i === 0 ? "estrella" : "estrellas"}: {label}</span>
                <svg viewBox="0 0 24 24" width="48" height="48" aria-hidden="true">
                  <path d={starPath} />
                </svg>
              </label>
            ))}
          </div>
          <p class="stars-caption" aria-live="polite">&nbsp;</p>
        </fieldset>

        <button type="button" class="btn btn-primary rate-next" hidden>Continuar</button>
      </section>

      <!-- 2a · Cinco estrellas → Google -->
      <section class="rate-step" data-step="google" aria-labelledby="google-title" hidden>
        <p class="rate-eyebrow">¡Gracias!</p>
        <h2 class="rate-title" id="google-title" tabindex="-1">Nos alegra mucho que te haya gustado.</h2>
        <p class="rate-lead">
          ¿Nos regalas tu reseña en Google Maps? Es lo que más nos ayuda a que
          otras personas en Cancún nos encuentren.
        </p>
        <ol class="google-tips">
          <li>Vuelve a marcar las <strong>5 estrellas</strong> en Google.</li>
          <li>Cuéntanos qué te hicimos, por ejemplo «corte láser de mi maqueta» o «llaveros para mi evento».</li>
          <li><strong>Sube una foto de tu pieza:</strong> es lo que más ayuda.</li>
        </ol>
        <a class="btn btn-primary rate-cta" href={SITE.gbpReview} rel="noopener">
          Dejar mi reseña en Google
          <span aria-hidden="true">→</span>
        </a>
        <button type="button" class="btn-text rate-back">← Cambiar mi calificación</button>
      </section>

      <!-- 2b · Menos de cinco → encuesta -->
      <section class="rate-step" data-step="survey" aria-labelledby="survey-title" hidden>
        <p class="rate-eyebrow">Queremos mejorar</p>
        <h2 class="rate-title" id="survey-title" tabindex="-1">Gracias por decírnoslo.</h2>
        <p class="rate-lead">
          Son 5 preguntas rápidas. Adriano, el fundador, lee cada respuesta.
        </p>

        <form class="survey" novalidate>
          {SURVEY.map((q, n) => (
            q.kind === "text" ? (
              <div class="survey-q" data-q={q.id} data-kind={q.kind} data-short={q.short}>
                <label class="survey-label" for={`q-${q.id}`}>
                  <span class="survey-num">{n + 1}</span>
                  <span>{q.label}{!q.required && <span class="survey-optional"> (opcional)</span>}</span>
                </label>
                <textarea id={`q-${q.id}`} name={q.id} rows="4" maxlength="600" placeholder={q.placeholder}></textarea>
              </div>
            ) : (
              <fieldset
                class="survey-q"
                data-q={q.id}
                data-kind={q.kind}
                data-short={q.short}
                data-required={q.required ? "" : undefined}
              >
                <legend class="survey-label">
                  <span class="survey-num">{n + 1}</span>
                  <span>{q.label}{q.kind === "multi" && <span class="survey-optional"> (puedes marcar varias)</span>}</span>
                </legend>
                <div class="chips">
                  {q.options.map((opt) => (
                    <label class="chip">
                      <input type={q.kind === "multi" ? "checkbox" : "radio"} name={q.id} value={opt} />
                      <span>{opt}</span>
                    </label>
                  ))}
                </div>
                <p class="survey-error" role="alert" hidden>Elige una opción.</p>
              </fieldset>
            )
          ))}

          <button type="submit" class="btn btn-primary survey-submit">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/>
            </svg>
            Enviar por WhatsApp
          </button>
          <p class="survey-hint">Se abre WhatsApp con tus respuestas ya escritas; solo toca enviar.</p>
        </form>

        <button type="button" class="btn-text rate-back">← Cambiar mi calificación</button>
      </section>

      <!-- 3 · Gracias -->
      <section class="rate-step" data-step="thanks" aria-labelledby="thanks-title" hidden>
        <p class="rate-eyebrow">Recibido</p>
        <h2 class="rate-title" id="thanks-title" tabindex="-1">¡Gracias por ayudarnos a mejorar!</h2>
        <p class="rate-lead">
          Si WhatsApp no se abrió, <a class="survey-retry" href="#">tócalo aquí</a>.
          Revisamos cada respuesta y te escribimos si hace falta.
        </p>
        <p class="rate-small">
          ¿También quieres dejar tu opinión en Google?
          <a href={SITE.gbpReview} rel="noopener">Puedes hacerlo aquí</a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</Base>

<script>
  type Step = "stars" | "google" | "survey" | "thanks";

  function bootRate() {
    const root = document.getElementById("rate");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const wa = root.dataset.wa ?? "";
    const labels: string[] = JSON.parse(root.dataset.labels ?? "[]");
    const steps = root.querySelectorAll<HTMLElement>(".rate-step");
    const stars = root.querySelector<HTMLElement>(".stars")!;
    const caption = root.querySelector<HTMLElement>(".stars-caption")!;
    const nextBtn = root.querySelector<HTMLButtonElement>(".rate-next")!;
    const form = root.querySelector<HTMLFormElement>(".survey")!;
    const retry = root.querySelector<HTMLAnchorElement>(".survey-retry")!;
    let rating = 0;
    let viaPointer = false;
    let advanceTimer = 0;

    const show = (name: Step) => {
      steps.forEach((s) => (s.hidden = s.dataset.step !== name));
      const heading = root.querySelector<HTMLElement>(`[data-step="${name}"] .rate-title`);
      heading?.focus({ preventScroll: true });
      root.scrollIntoView({ block: "start" });
    };

    const paint = (n: number) => {
      stars.dataset.fill = String(n);
    };

    const advance = () => show(rating === 5 ? "google" : "survey");

    stars.addEventListener("pointerdown", () => (viaPointer = true));
    stars.addEventListener("pointerover", (e) => {
      const input = (e.target as HTMLElement).closest(".star")?.querySelector("input");
      if (input) paint(Number(input.value));
    });
    stars.addEventListener("pointerleave", () => paint(rating));

    stars.addEventListener("change", (e) => {
      rating = Number((e.target as HTMLInputElement).value);
      paint(rating);
      caption.textContent = labels[rating - 1] ?? "";
      nextBtn.hidden = false;
      window.clearTimeout(advanceTimer);
      // A tap goes straight on; keyboard users move with arrows and confirm with the button.
      if (viaPointer) advanceTimer = window.setTimeout(advance, 450);
      viaPointer = false;
    });

    nextBtn.addEventListener("click", advance);
    root.querySelectorAll(".rate-back").forEach((b) =>
      b.addEventListener("click", () => {
        window.clearTimeout(advanceTimer);
        show("stars");
      }),
    );

    form.addEventListener("change", (e) => {
      const q = (e.target as HTMLElement).closest<HTMLElement>(".survey-q");
      const err = q?.querySelector<HTMLElement>(".survey-error");
      if (err) err.hidden = true;
      q?.classList.remove("is-invalid");
    });

    const buildMessage = () => {
      const lines = [
        "Hola Lumo, les dejo mi opinión sobre mi pedido:",
        `⭐ Calificación: ${rating} de 5`,
      ];
      form.querySelectorAll<HTMLElement>(".survey-q").forEach((q, i) => {
        let answer = "";
        if (q.dataset.kind === "text") {
          answer = q.querySelector("textarea")?.value.trim() ?? "";
        } else {
          answer = Array.from(q.querySelectorAll<HTMLInputElement>("input:checked"))
            .map((i) => i.value)
            .join(", ");
        }
        lines.push(`${i + 1}. ${q.dataset.short}: ${answer || "—"}`);
      });
      return `https://wa.me/${wa}?text=${encodeURIComponent(lines.join("\n"))}`;
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLElement>(".survey-q[data-required]").forEach((q) => {
        const answered = q.querySelector("input:checked");
        q.classList.toggle("is-invalid", !answered);
        const err = q.querySelector<HTMLElement>(".survey-error");
        if (err) err.hidden = Boolean(answered);
        if (!answered && !firstInvalid) firstInvalid = q;
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).scrollIntoView({ block: "center", behavior: "smooth" });
        (firstInvalid as HTMLElement).querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
        return;
      }
      const url = buildMessage();
      retry.href = url;
      window.open(url, "_blank", "noopener");
      show("thanks");
    });
  }

  bootRate();
  document.addEventListener("astro:page-load", bootRate);
</script>

<style>
  .rate {
    background: var(--color-bg);
    padding: calc(var(--nav-h) + 56px) 0 96px;
    min-height: 80vh;
  }

  .rate-inner {
    max-width: 640px;
  }

  .rate-step[hidden] {
    display: none;
  }

  .rate-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .rate-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin-bottom: 16px;
    outline: none;
  }

  .rate-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 32px;
  }

  .rate-lead a,
  .rate-small a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rate-small {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Estrellas ─────────────────────────────────────────────── */
  .stars-field {
    border: 0;
    padding: 0;
    margin: 0 0 24px;
  }

  .stars {
    display: flex;
    gap: 8px;
  }

  .star {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .star input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .star svg {
    fill: transparent;
    stroke: var(--color-accent-honey);
    stroke-width: 1.4;
    stroke-linejoin: round;
    transition: fill 0.15s ease, transform 0.15s ease;
  }

  .star:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .stars[data-fill="1"] .star:nth-child(-n + 1) svg,
  .stars[data-fill="2"] .star:nth-child(-n + 2) svg,
  .stars[data-fill="3"] .star:nth-child(-n + 3) svg,
  .stars[data-fill="4"] .star:nth-child(-n + 4) svg,
  .stars[data-fill="5"] .star:nth-child(-n + 5) svg {
    fill: var(--color-accent-honey);
  }

  .star:has(input:checked) svg {
    transform: scale(1.12);
  }

  .stars-caption {
    margin-top: 12px;
    font-weight: 500;
    color: var(--color-text);
    min-height: 1.5em;
  }

  .rate-next[hidden] {
    display: none;
  }

  /* ── Cinco estrellas ───────────────────────────────────────── */
  .google-tips {
    margin: 0 0 32px;
    padding-left: 24px;
    display: grid;
    gap: 12px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .rate-cta {
    width: 100%;
    justify-content: center;
    padding: 16px 24px;
    font-size: 1rem;
  }

  .btn-text {
    display: inline-block;
    margin-top: 24px;
    padding: 8px 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .btn-text:hover {
    color: var(--color-accent);
  }

  /* ── Encuesta ──────────────────────────────────────────────── */
  .survey {
    display: grid;
    gap: 32px;
  }

  .survey-q {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .survey-label {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 0;
    margin-bottom: 16px;
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .survey-num {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--page-accent-soft);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .survey-optional {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-block;
    padding: 10px 16px;
    border: 1.5px solid var(--color-surface);
    border-radius: 999px;
    background: #fff;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--color-text);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .chip:hover span {
    border-color: var(--color-accent);
  }

  .chip input:checked + span {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .survey-q.is-invalid .chip span {
    border-color: var(--color-accent-dark);
  }

  .survey-error {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--color-accent-dark);
    font-weight: 500;
  }

  .survey-error[hidden] {
    display: none;
  }

  .survey textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    background: #fff;
    border: 1.5px solid var(--color-surface);
    border-radius: 6px;
    padding: 12px 16px;
    width: 100%;
    min-height: 112px;
    resize: vertical;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .survey textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px rgba(165, 58, 4, 0.1);
  }

  .survey-submit {
    width: 100%;
    justify-content: center;
    padding: 16px 24px;
    font-size: 1rem;
    gap: 10px;
  }

  .survey-hint {
    margin-top: -16px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }

  @media (max-width: 480px) {
    .rate {
      padding: calc(var(--nav-h) + 32px) 0 112px;
    }

    .stars {
      gap: 4px;
    }

    .star {
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star svg,
    .chip span {
      transition: none;
    }

    .star:has(input:checked) svg {
      transform: none;
    }
  }
</style>
