---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SectorsGrid from "../../components/SectorsGrid.astro";
import BusinessCases from "../../components/BusinessCases.astro";
import VolumeProcess from "../../components/VolumeProcess.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { segments } from "../../data/segments";
import { absUrl, ORG_ID } from "../../data/services";

// Hub: one quotable comparison of what Lumo produces for each sector.
const rows = segments.map((s) => ({
  name: s.name,
  slug: s.slug,
  piezas: s.productos.slice(0, 3).map((p) => p.name).join(", "),
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  url: absUrl("/sectores/"),
  name: "Sectores — Lumo Cancún",
  about: { "@id": ORG_ID },
  mainEntity: {
    "@type": "ItemList",
    name: "Sectores para los que Lumo Cancún fabrica en serie",
    itemListElement: segments.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: absUrl(s.slug),
      name: s.name,
    })),
  },
};
---

<Base
  title="Producción en serie para negocios en Cancún | Lumo Cancún"
  description="Corte láser e impresión 3D en serie en Cancún para hoteles, restaurantes, marcas, tiendas de souvenirs y eventos. Qué fabricamos para cada sector y cómo pedir por volumen."
  canonical="/sectores/"
  extraSchemas={[collectionSchema]}
>
  <Nav variant="solid" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Sectores" },
      ]}
    />

    <header class="hub-hero">
      <div class="container">
        <p class="hub-eyebrow">Sectores</p>
        <h1 class="hub-title">Producción en serie para negocios en <em>Cancún</em></h1>
        <p class="hub-lede">
          Lumo Cancún fabrica con corte láser e impresión 3D la misma pieza
          por decenas o miles — para hoteles y restaurantes, marcas y
          corporativos, tiendas de souvenirs y eventos. Hemos entregado lotes
          de alrededor de 1,500 piezas en un solo pedido.
        </p>
      </div>
    </header>

    <section class="hub-table section">
      <div class="container">
        <h2 class="section-title">Qué fabricamos para cada sector</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Sector</th>
                <th scope="col">Piezas típicas</th>
                <th scope="col">Técnicas</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row"><a href={r.slug}>{r.name}</a></th>
                  <td>{r.piezas}</td>
                  <td>Corte y grabado láser · impresión 3D</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <SectorsGrid title="Elige tu sector" subtitle="Cada sector tiene su página con productos, fotos de lotes reales y preguntas frecuentes." />
    <BusinessCases />
    <VolumeProcess />
    <QuoteForm />
  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .hub-hero {
    padding: 56px 0 24px;
    background: var(--color-bg-alt);
  }

  .hub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .hub-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.08;
    color: var(--color-text);
    max-width: 18ch;
    margin-bottom: 20px;
  }

  .hub-title em {
    color: var(--color-accent);
  }

  .hub-lede {
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  .hub-table {
    background: var(--color-bg-alt);
    padding-top: 32px;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    background: var(--color-bg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    text-align: left;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-surface);
    vertical-align: top;
  }

  thead th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody th a {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  tbody th a:hover {
    color: var(--color-accent);
  }

  td {
    color: var(--color-muted);
  }
</style>
