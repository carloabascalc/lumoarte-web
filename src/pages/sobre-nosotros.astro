---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { SITE, absUrl, ORG_ID, FOUNDER_ID } from "../data/services";

// Person schema for Adriano — links the founder to the LocalBusiness and to
// his architecture firm. Improves E-E-A-T signals because the business now
// has a named, credentialed author/founder visible to crawlers.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": FOUNDER_ID,
  name: "Adriano Abascal",
  jobTitle: "Fundador de Lumo Cancún",
  hasOccupation: { "@type": "Occupation", name: "Arquitecto" },
  description:
    "Arquitecto cancunense, fundador de Lumo Cancún, taller de producción en serie con corte láser e impresión 3D para hoteles, restaurantes, marcas, tiendas de souvenirs y eventos.",
  url: absUrl("/sobre-nosotros/"),
  worksFor: { "@id": ORG_ID },
  affiliation: {
    "@type": "Organization",
    name: "Abascal Arquitectos",
    url: "https://abascalarquitectos.com/",
  },
  knowsAbout: [
    "Arquitectura",
    "Fabricación digital",
    "Producción en serie",
    "Corte láser",
    "Impresión 3D",
    "Diseño paramétrico",
    "Manufactura aditiva",
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: absUrl("/sobre-nosotros/"),
  name: "Sobre nosotros — Lumo Cancún",
  mainEntity: { "@id": ORG_ID },
  about: { "@id": FOUNDER_ID },
};
---

<Base
  title="Sobre nosotros — Lumo Cancún | Producción en serie en Cancún"
  description="Lumo Cancún es un taller de producción en serie en Cancún fundado por Adriano Abascal, arquitecto. Corte láser e impresión 3D por volumen para hoteles, restaurantes, marcas, tiendas y eventos."
  canonical="/sobre-nosotros/"
  ogImage="/og/default.jpg"
  extraSchemas={[personSchema, aboutPageSchema]}
>
  <Nav variant="solid" ctaHref="/#cotiza" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Sobre nosotros" },
      ]}
    />

    <article class="about-page">
      <header class="about-hero">
        <div class="container">
          <p class="about-eyebrow" data-reveal>Sobre Lumo Cancún</p>
          <h1 class="about-h1" data-reveal data-reveal-delay="0.06">
            La misma pieza, muchas veces, bien hecha.
          </h1>
          <p class="about-lede" data-reveal data-reveal-delay="0.12">
            Fundado en Cancún por Adriano Abascal, arquitecto e hijo de la
            ciudad. Producimos en serie con corte láser e impresión 3D para
            negocios que necesitan piezas idénticas, lote tras lote.
          </p>
        </div>
      </header>

      <section class="about-body section">
        <div class="container about-grid">
          <div class="about-text">
            <h2>Cómo empezamos</h2>
            <p>
              Lumo Cancún nació en Cancún como una extensión natural del estudio
              de arquitectura de Adriano. Empezamos con corte láser
              para resolver maquetas, piezas a medida y elementos
              decorativos para los proyectos del despacho. Pronto llegaron
              negocios que querían esas piezas por cientos — y la producción
              en serie se volvió el centro del taller.
            </p>

            <h2>Hoy</h2>
            <p>
              Producimos con impresión 3D Bambu Lab y resina, y con corte
              láser de 130 × 90 cm de área útil, todos los días. No somos carpintería:
              todo se fabrica a partir de un archivo digital, por eso cada
              pieza del lote sale igual y reponer un pedido es un mensaje.
            </p>

            <h2>A quién servimos</h2>
            <p>
              A hoteles y restaurantes, marcas y corporativos, tiendas de
              souvenirs y mayoristas, y a wedding planners y agencias de
              eventos — negocios que necesitan la misma pieza muchas veces,
              con el cuidado de una pieza hecha a mano.
            </p>

            <h2>Cómo trabajamos</h2>
            <p>
              Cotización inmediata por WhatsApp, con precio por volumen: entre
              más piezas, menor el costo por pieza. Los proyectos
              habitualmente se entregan en menos de una semana — cuando hay
              disponibilidad, el mismo día. Aceptamos archivos
              vectoriales (AI, EPS, SVG, PDF, DXF) y modelos 3D (STL, OBJ,
              3MF, STEP). Si solo tienes una imagen nítida, vectorizamos
              por ti — incluido en la cotización cuando es sencillo.
            </p>
          </div>

          <aside class="about-side">
            <div class="about-card about-card--clients">
              <p class="about-card-eyebrow">Clientes destacados</p>
              <ul class="clients-list" role="list">
                <li class="client-item">
                  <strong class="client-name">L'Oréal</strong>
                  <span class="client-desc">Piezas corporativas personalizadas</span>
                </li>
                <li class="client-item">
                  <strong class="client-name">Hotelería en Cancún</strong>
                  <span class="client-desc">Cerca de 1,500 cuadros enmarcados para un hotel</span>
                </li>
                <li class="client-item">
                  <strong class="client-name">La Central Vinos &amp; Licores</strong>
                  <span class="client-desc">Señalética en acrílico negro y dorado</span>
                </li>
                <li class="client-item">
                  <strong class="client-name">BeStar Generation · Emerald B2</strong>
                  <span class="client-desc">Placas grabadas y termos con logo para eventos y marca</span>
                </li>
              </ul>
            </div>

            <div class="about-card">
              <p class="about-card-eyebrow">Fundador</p>
              <h3 class="about-card-name">Adriano Abascal</h3>
              <p class="about-card-role">Arquitecto · Fundador</p>
              <p class="about-card-bio">
                Arquitecto cancunense. También dirige
                <a href="https://abascalarquitectos.com/" target="_blank" rel="noopener">
                  Abascal Arquitectos
                </a>, su estudio de arquitectura. Lumo es donde su práctica
                profesional se encuentra con la fabricación digital.
              </p>
            </div>

            <div class="about-card">
              <p class="about-card-eyebrow">Ubicación</p>
              <h3 class="about-card-name">Cancún, Q. Roo</h3>
              <p class="about-card-bio">
                Retorno Tejón, Sm 20, Mz 3, Lt 2 — CP 77500.<br/>
                Lunes a sábado, 9:00 a 18:00.
              </p>
              <a class="about-card-link" href={SITE.gbp} target="_blank" rel="noopener">
                Ver en Google Maps →
              </a>
            </div>

            <div class="about-card about-card--cta">
              <p class="about-card-eyebrow">Contáctanos</p>
              <p class="about-card-bio">
                Mándanos la pieza, la cantidad y la fecha. Te cotizamos el
                lote con precio por volumen — sin compromiso.
              </p>
              <a class="btn btn-primary" href={`https://wa.me/${SITE.whatsapp}`}>
                WhatsApp
              </a>
            </div>
          </aside>
        </div>
      </section>
    </article>
  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .about-page {
    padding-bottom: 80px;
  }

  .about-hero {
    padding: 32px 0 56px;
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .about-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .about-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 24px;
    max-width: 760px;
  }

  .about-lede {
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 640px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 64px;
    align-items: start;
  }

  .about-text h2 {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 40px;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .about-text h2:first-child {
    margin-top: 0;
  }

  .about-text p {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1.0625rem;
    margin-bottom: 12px;
  }

  .about-side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-card {
    padding: 22px;
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    background: var(--color-bg);
  }

  .about-card--cta {
    background: var(--color-bg-alt);
  }

  .about-card-eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .about-card-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .about-card-role {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .about-card-bio {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .about-card-bio a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-card-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .about-card-link:hover {
    color: var(--color-accent-dark);
  }

  .about-card--clients {
    background: var(--color-bg-tint);
    border-color: var(--color-surface);
  }

  .clients-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 12px;
  }

  .client-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 14px;
    border-left: 2px solid var(--color-accent);
  }

  .client-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .client-desc {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  @media (max-width: 880px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-side {
      position: static;
    }
  }
</style>
