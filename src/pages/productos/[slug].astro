---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ServicePageHero from "../../components/ServicePageHero.astro";
import SectorShowcase from "../../components/SectorShowcase.astro";
import TrustBand from "../../components/TrustBand.astro";
import SectorsGrid from "../../components/SectorsGrid.astro";
import BusinessCases from "../../components/BusinessCases.astro";
import VolumeProcess from "../../components/VolumeProcess.astro";
import FAQ from "../../components/FAQ.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { products, type Product } from "../../data/products";
import { SITE, absUrl } from "../../data/services";
import { segmentImage, segmentAlt } from "../../data/segmentImages";
import { getImage } from "astro:assets";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug.split("/").filter(Boolean).pop() },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

// Range + past fact, never a promised capacity or a hard minimum.
const faqs = [
  ...product.faqs,
  {
    question: "¿Desde cuántas piezas trabajan?",
    answer: "Trabajamos lotes de decenas a miles de piezas. Como referencia, hemos entregado lotes de alrededor de 1,500 piezas en un solo pedido (cuadros enmarcados para un hotel en Cancún). Entre más piezas, menor el costo por pieza; cada lote se cotiza según la pieza, el material y la cantidad.",
  },
];

const others = products.filter((p) => p.id !== product.id);

// Production photos as ImageObjects (hashed /_astro URLs resolved at build).
const schemaImages = await Promise.all(
  product.images.map(async (file) => {
    const img = await getImage({ src: segmentImage(file), width: 1200, format: "jpg" });
    return {
      "@type": "ImageObject",
      contentUrl: new URL(img.src, SITE.url).href,
      caption: segmentAlt(file),
      creditText: SITE.name,
    };
  }),
);

const serviceSchema = {
  "@id": `${absUrl(product.slug)}#service`,
  name: product.name,
  serviceType: product.serviceType,
  description: product.metaDescription,
  url: absUrl(product.slug),
  audience: {
    "@type": "BusinessAudience",
    audienceType: product.audience,
    geographicArea: { "@type": "Country", name: "México" },
  },
  image: schemaImages,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: product.name,
    itemListElement: product.variantes.map((v) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Product", name: v.name, description: v.desc },
    })),
  },
};
---

<Base
  title={product.metaTitle}
  description={product.metaDescription}
  canonical={product.slug}
  schemaType="Service"
  schemaData={serviceSchema}
>
  <Nav variant="solid" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Productos", href: "/productos/" },
        { label: product.name },
      ]}
      backHref="/productos/"
      backLabel="Regresar a productos"
    />

    <ServicePageHero
      eyebrow={product.eyebrow}
      title={product.h1}
      subtitle={product.subtitle}
      primaryCta={{ label: "Cotiza tu producción", href: "#cotiza" }}
      secondaryCta={{ label: "Opciones", href: "#productos" }}
      service={product.service}
    >
      <SectorShowcase slot="showcase" images={product.images} />
    </ServicePageHero>

    <section class="productos section" id="productos">
      <div class="container">
        <div class="section-header">
          <p class="productos-eyebrow" data-reveal>En serie, con tu marca</p>
          <h2 class="section-title" data-reveal data-reveal-delay="0.06">Opciones</h2>
        </div>
        <ul class:list={["productos-grid", { "productos-grid--two": product.variantes.length % 3 !== 0 }]} role="list">
          {product.variantes.map((p, i) => (
            <li class="producto" data-reveal data-reveal-delay={`${0.04 + i * 0.04}`}>
              <h3 class="producto-name">{p.name}</h3>
              <p class="producto-desc">{p.desc}</p>
            </li>
          ))}
        </ul>
        <p class="productos-services" data-reveal>
          Con <a href="/servicios/corte-laser/">corte láser</a> e
          <a href="/servicios/impresion-3d/">impresión 3D</a> — en acrílico,
          MDF, triplay, cuero, filamento y resina.
        </p>
      </div>
    </section>

    {product.cases && <BusinessCases clients={product.cases} title="Trabajos reales" />}

    <TrustBand />

    <VolumeProcess />

    <FAQ
      title={`Preguntas frecuentes · ${product.name}`}
      subtitle="Si la tuya no aparece, mándanos un WhatsApp."
      items={faqs}
    />

    <QuoteForm />

    <SectorsGrid
      onlyIds={product.sectors}
      title="Para quién los fabricamos"
      subtitle="Cada sector tiene su página con más productos y casos:"
    />

    <section class="otros section">
      <div class="container">
        <h2 class="section-title">Otros productos</h2>
        <ul class="otros-list" role="list">
          {others.map((o) => (
            <li><a href={o.slug}><strong>{o.name}</strong><span>{o.blurb}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .productos {
    background: var(--color-bg);
  }

  .productos-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .productos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    overflow: hidden;
  }

  .productos-grid--two {
    grid-template-columns: repeat(2, 1fr);
  }

  .producto {
    background: var(--color-bg);
    padding: 32px 28px;
  }

  .producto-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .producto-desc {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .productos-services {
    margin-top: 28px;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .productos-services a {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 880px) {
    .productos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .productos-grid {
      grid-template-columns: 1fr;
    }
  }

  .otros {
    background: var(--color-bg-alt);
  }

  .otros-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    max-width: 880px;
  }

  .otros-list a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    background: var(--color-bg);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .otros-list a:hover {
    border-color: var(--color-accent);
  }

  .otros-list strong {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .otros-list span {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 560px) {
    .otros-list {
      grid-template-columns: 1fr;
    }
  }
</style>
