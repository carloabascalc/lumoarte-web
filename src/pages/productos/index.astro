---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SectorsGrid from "../../components/SectorsGrid.astro";
import BusinessCases from "../../components/BusinessCases.astro";
import VolumeProcess from "../../components/VolumeProcess.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { products } from "../../data/products";
import { absUrl, ORG_ID } from "../../data/services";

// Hub: one quotable comparison of the products Lumo makes in series.
const rows = products.map((p) => ({
  name: p.name,
  slug: p.slug,
  piezas: p.variantes.slice(0, 3).map((v) => v.name).join(" · "),
  tecnica: p.service === "3d" ? "Impresión 3D · grabado láser" : "Corte y grabado láser",
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  url: absUrl("/productos/"),
  name: "Productos — Lumo Cancún",
  about: { "@id": ORG_ID },
  mainEntity: {
    "@type": "ItemList",
    name: "Productos que Lumo Cancún fabrica en serie",
    itemListElement: products.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: absUrl(s.slug),
      name: s.name,
    })),
  },
};
---

<Base
  title="Productos con logo por mayoreo en Cancún | Lumo Cancún"
  description="Llaveros con logo, trofeos impresos en 3D, placas y señalética en serie en Cancún, con corte láser e impresión 3D. Lotes de decenas a miles de piezas."
  canonical="/productos/"
  extraSchemas={[collectionSchema]}
>
  <Nav variant="solid" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Productos" },
      ]}
    />

    <header class="hub-hero">
      <div class="container">
        <p class="hub-eyebrow">Productos</p>
        <h1 class="hub-title">Productos con logo por mayoreo en <em>Cancún</em></h1>
        <p class="hub-lede">
          Lumo Cancún fabrica en serie, con corte láser e impresión 3D, las
          piezas que más piden hoteles, marcas, tiendas de souvenirs y eventos:
          llaveros con logo, trofeos y premios, placas y señalética. Lotes de
          decenas a miles de piezas, con precio por volumen.
        </p>
      </div>
    </header>

    <section class="hub-table section">
      <div class="container">
        <h2 class="section-title">Qué fabricamos en serie</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Producto</th>
                <th scope="col">Opciones</th>
                <th scope="col">Técnicas</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row"><a href={r.slug}>{r.name}</a></th>
                  <td>{r.piezas}</td>
                  <td>{r.tecnica}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <SectorsGrid title="Por sector" subtitle="¿Prefieres ver todo lo que hacemos para tu tipo de negocio?" />
    <BusinessCases />
    <VolumeProcess />
    <QuoteForm />
  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .hub-hero {
    padding: 56px 0 24px;
    background: var(--color-bg-alt);
  }

  .hub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .hub-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.08;
    color: var(--color-text);
    max-width: 18ch;
    margin-bottom: 20px;
  }

  .hub-title em {
    color: var(--color-accent);
  }

  .hub-lede {
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  .hub-table {
    background: var(--color-bg-alt);
    padding-top: 32px;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    background: var(--color-bg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    text-align: left;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-surface);
    vertical-align: top;
  }

  thead th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody th a {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  tbody th a:hover {
    color: var(--color-accent);
  }

  td {
    color: var(--color-muted);
  }
</style>
