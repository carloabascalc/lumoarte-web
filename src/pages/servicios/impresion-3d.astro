---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ServicePageHero from "../../components/ServicePageHero.astro";
import ServicePdfs from "../../components/ServicePdfs.astro";
import PricingFormula from "../../components/PricingFormula.astro";
import TresDShowcase from "../../components/TresDShowcase.astro";
import TresDAssembly from "../../components/TresDAssembly.astro";
import TresDMachines from "../../components/TresDMachines.astro";
import Gallery from "../../components/Gallery.astro";
import FAQ from "../../components/FAQ.astro";
import ServiceLinks from "../../components/ServiceLinks.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { getService, absUrl } from "../../data/services";

const service = getService("impresion-3d");

const technologies = [
  {
    label: "FDM — plástico fundido",
    eyebrow: "Línea de impresoras Bambu Lab",
    description:
      "Imprimimos con filamentos termoplásticos en máquinas Bambu Lab. La H2C imprime hasta cuatro colores en una misma pieza con una velocidad y consistencia de nivel industrial.",
    materiales: ["PLA", "PETG", "TPU", "ABS", "ASA", "Nylon", "Fibra de carbono", "Gran variedad de colores"],
    usos: [
      "Producción en serie de piezas y productos",
      "Souvenirs, llaveros y merch por lote",
      "Prototipos funcionales",
      "Piezas mecánicas y repuestos",
    ],
  },
];

const serviceSchema = {
  "@id": `${absUrl(service.slug)}#service`,
  name: service.name,
  serviceType: "Impresión 3D en serie",
  description: service.metaDescription,
  url: absUrl(service.slug),
  offers: {
    "@type": "Offer",
    url: `${absUrl(service.slug)}#cotiza`,
    priceCurrency: "MXN",
    businessFunction: "http://purl.org/goodrelations/v1#Sell",
    eligibleCustomerType: "http://purl.org/goodrelations/v1#Business",
    eligibleRegion: { "@type": "Country", name: "MX" },
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      priceCurrency: "MXN",
      valueAddedTaxIncluded: false,
      description:
        "Precio por pieza según material y tiempo de máquina; el costo unitario baja conforme sube la cantidad. Cotización por lote vía WhatsApp.",
    },
  },
};

const faqs = [
  {
    question: "¿Cuánto tarda imprimir una pieza?",
    answer:
      "Habitualmente menos de una semana. Las producciones por lote las calendarizamos contigo al cotizar, según cantidad y material.",
  },
  {
    question: "¿Qué archivo necesitan para imprimir?",
    answer:
      "Lo ideal es un STL o STEP listo para imprimir, con paredes cerradas y geometría sólida. Si solo tienes un dibujo, una foto o una idea, podemos modelarlo desde cero — el modelado 3D se cotiza por separado dependiendo de la complejidad. También aceptamos OBJ, 3MF y archivos de Fusion 360 / SolidWorks.",
  },
  {
    question: "¿Cómo elijo el material?",
    answer:
      "PLA es el de uso general: souvenirs, llaveros y piezas decorativas por lote. PETG para piezas durables o de exterior, TPU cuando la pieza debe ser flexible, y ABS o ASA cuando necesita más resistencia. Para piezas técnicas también imprimimos en nylon y fibra de carbono. Si no estás seguro, mándanos el archivo y te recomendamos sin compromiso.",
  },
  {
    question: "¿Cuál es el tamaño máximo que pueden imprimir?",
    answer:
      "En una sola pieza imprimimos hasta 33 × 32 × 32.5 cm, también en multicolor. Para piezas más grandes, las dividimos en módulos que se ensamblan después con casi ninguna línea visible.",
  },
  {
    question: "¿Pintan o dan acabado a la pieza?",
    answer:
      "Sí. Ofrecemos lijado, primer, pintura con aerógrafo y acabados especiales (mate, satinado, brillante, metalizado). El acabado se cotiza aparte porque toma tiempo de mano de obra. Para FDM también podemos hacer alisado con vapor de acetona en piezas ABS.",
  },
  {
    question: "¿Hacen impresión 3D en serie o por volumen?",
    answer:
      "Sí. Imprimimos lotes de decenas a miles de piezas idénticas para negocios: souvenirs y llaveros, merch con logo, piezas de producto y refacciones. El precio baja conforme sube la cantidad — entre más unidades, menor el costo por pieza.",
  },
];

---

<Base
  title={`${service.name} en serie en Cancún | Lumo Cancún`}
  description={service.metaDescription}
  canonical={service.slug}
  ogImage="/og/impresion-3d.jpg"
  schemaType="Service"
  schemaData={serviceSchema}
  pageAccent="3d"
>
  <Nav variant="solid" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Servicios", href: "/#servicios" },
        { label: service.name },
      ]}
      backHref="/#servicios"
      backLabel="Regresar a servicios"
    />

    <ServicePageHero
      eyebrow="Impresión 3D en serie"
      title="Del prototipo a la producción en serie, en <em>Cancún</em>"
      subtitle="Imprimimos en 3D por lote con máquinas Bambu Lab — FDM multicolor y materiales técnicos. Productos, souvenirs y piezas para tu negocio, con precio por volumen y sin enviarlos fuera de la ciudad."
      primaryCta={{ label: "Cotiza tu producción", href: "#cotiza" }}
      secondaryCta={{ label: "Ver cómo imprimimos", href: "#tecnologias" }}
      service="3d"
    >
      <TresDShowcase slot="showcase" />
    </ServicePageHero>

    <ServicePdfs service={service} />

    <TresDAssembly />

    <Gallery
      filterService="impresion-3d"
      title="Trabajos de impresión 3D"
      subtitle="Producción por lote salida de nuestras Bambu Lab: llaveros, figuras, trofeos y piezas en serie."
    />

    <section class="tech section" id="tecnologias">
      <div class="container">
        <div class="section-header">
          <p class="tech-eyebrow" data-reveal>Nuestra tecnología</p>
          <h2 class="section-title" data-reveal data-reveal-delay="0.06">
            Elegimos el material según la pieza
          </h2>
          <p class="section-subtitle" data-reveal data-reveal-delay="0.12">
            Imprimimos en FDM con impresoras Bambu Lab. Te recomendamos el material
            sin compromiso, evaluando geometría, tamaño, detalle y uso final.
          </p>
        </div>
        <div class="tech-grid">
          {technologies.map((t, i) => (
            <article class="tech-card" data-tilt data-reveal data-reveal-delay={`${0.04 + i * 0.08}`}>
              <p class="tech-card-eyebrow">{t.eyebrow}</p>
              <h3 class="tech-card-name">{t.label}</h3>
              <p class="tech-card-description">{t.description}</p>
              <div class="tech-card-section">
                <p class="tech-card-section-label">Materiales</p>
                <ul class="tech-card-tags" role="list">
                  {t.materiales.map((m) => <li class="tech-card-tag">{m}</li>)}
                </ul>
              </div>
              <div class="tech-card-section">
                <p class="tech-card-section-label">Usos típicos</p>
                <ul class="tech-card-list" role="list">
                  {t.usos.map((u) => <li>{u}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <PricingFormula serviceId="impresion-3d" />

    <TresDMachines />

    <FAQ
      title="Preguntas frecuentes sobre impresión 3D"
      subtitle="Las dudas que nos hacen más seguido. Si la tuya no aparece, mándanos un WhatsApp."
      items={faqs}
    />

    <ServiceLinks excludeId="impresion-3d" />

    <QuoteForm defaultService="impresion-3d" />
  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

<style>
  .tech {
    background: var(--color-bg-alt);
  }

  .tech-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    perspective: 1400px;
  }

  .tech-card {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transform-style: preserve-3d;
    isolation: isolate;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 900px) {
    .tech-card {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: min-content;
      column-gap: 56px;
      row-gap: 24px;
    }

    .tech-card > :not(.tech-card-section) {
      grid-column: 1;
    }

    .tech-card-description {
      grid-row: 3 / span 2;
    }

    .tech-card-section {
      grid-column: 2;
      grid-row: 1 / span 3;
    }

    .tech-card-section + .tech-card-section {
      grid-row: 4;
    }
  }

  .tech-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 22px 48px rgba(20, 10, 4, 0.10);
  }

  .tech-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle 280px at var(--gx, 50%) var(--gy, 50%),
      rgba(255, 240, 220, 0.30) 0%,
      rgba(255, 240, 220, 0.10) 25%,
      transparent 60%);
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.3s ease;
    border-radius: inherit;
    z-index: 1;
  }

  .tech-card:hover::after { opacity: 1; }

  .tech-card > * { position: relative; z-index: 2; }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .tech-card { transform-style: flat; }
    .tech-card::after { display: none; }
  }

  .tech-card-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tech-card-name {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: -12px;
  }

  .tech-card-description {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .tech-card-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .tech-card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-card-tag {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-surface);
    color: var(--color-text);
    font-size: 0.8125rem;
    padding: 6px 12px;
    border-radius: 4px;
  }

  .tech-card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tech-card-list li {
    color: var(--color-muted);
    font-size: 0.9375rem;
    padding-left: 18px;
    position: relative;
  }

  .tech-card-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    width: 8px;
    height: 1.5px;
    background: var(--color-accent);
  }

  @media (max-width: 768px) {
    .tech-card {
      padding: 32px 28px;
    }
  }
</style>

<script>
  import { initCardTilt } from "../../scripts/cardTilt";
  const init = () => initCardTilt(".tech-card[data-tilt]");
  init();
  document.addEventListener("astro:page-load", init);
</script>
