---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ServicePageHero from "../../components/ServicePageHero.astro";
import ServicePdfs from "../../components/ServicePdfs.astro";
import PricingFormula from "../../components/PricingFormula.astro";
import PriceTable from "../../components/PriceTable.astro";
import LaserShowcase from "../../components/LaserShowcase.astro";
import LaserAssembly from "../../components/LaserAssembly.astro";
import Materials from "../../components/Materials.astro";
import Gallery from "../../components/Gallery.astro";
import ServiceLinks from "../../components/ServiceLinks.astro";
import FAQ from "../../components/FAQ.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { getService, absUrl } from "../../data/services";

const service = getService("corte-laser");


const serviceSchema = {
  "@id": `${absUrl(service.slug)}#service`,
  name: service.name,
  serviceType: "Corte y grabado láser en serie",
  description: service.metaDescription,
  url: absUrl(service.slug),
  offers: {
    "@type": "Offer",
    url: `${absUrl(service.slug)}#cotiza`,
    priceCurrency: "MXN",
    businessFunction: "http://purl.org/goodrelations/v1#Sell",
    eligibleCustomerType: "http://purl.org/goodrelations/v1#Business",
    eligibleRegion: { "@type": "Country", name: "MX" },
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      priceCurrency: "MXN",
      valueAddedTaxIncluded: false,
      description:
        "Precio por pieza según material y tiempo de máquina; el costo unitario baja conforme sube la cantidad. Cotización por lote vía WhatsApp.",
    },
  },
};

const faqs = [
  {
    question: "¿Cuánto tarda un trabajo de corte láser?",
    answer:
      "Habitualmente menos de una semana. Las producciones grandes las calendarizamos contigo al cotizar, según cantidad y material. Si tu fecha es fija, dila en la cotización.",
  },
  {
    question: "¿Qué tipo de archivo necesito enviar?",
    answer:
      "Trabajamos con vectores en formato AI, EPS, SVG, PDF o DXF. Si solo tienes una imagen JPG o PNG nítida, podemos vectorizarla por ti — incluido en la cotización si no es muy compleja. Lo importante es que las líneas estén limpias y la escala sea la real (en milímetros o centímetros).",
  },
  {
    question: "¿Cuál es el tamaño máximo de corte?",
    answer:
      "El área útil de nuestra máquina es de 130 × 90 cm en una sola pieza. Para piezas más grandes, las dividimos en módulos que ensamblan invisiblemente — así hemos hecho paneles y celosías de varios metros.",
  },
  {
    question: "¿Hacen producción en serie o por volumen?",
    answer:
      "Sí, es nuestro fuerte. Cortamos y grabamos lotes de decenas a miles de piezas idénticas —hemos entregado lotes de alrededor de 1,500 piezas—: llaveros, posavasos, placas, cajas, señalética y regalos corporativos con logo. El costo por pieza baja conforme sube la cantidad, porque el material se aprovecha mejor y la máquina trabaja en corridas continuas. Guardamos tu archivo para que reponer sea un solo mensaje.",
  },
  {
    question: "¿Son carpintería? ¿Hacen muebles?",
    answer:
      "No. Somos un taller de fabricación digital: cortamos y grabamos con láser láminas de MDF, triplay, acrílico, cuero y otros materiales a partir de un archivo. No fabricamos muebles ni hacemos trabajos de carpintería.",
  },
  {
    question: "¿Hacen entrega o envíos?",
    answer:
      "En Cancún hacemos entrega a domicilio dentro de la zona metropolitana con costo según ubicación. Para Playa del Carmen, Tulum, Mérida y otras ciudades enviamos por paquetería (DHL, Estafeta) — el costo lo agregamos a la cotización. También puedes recoger en el taller en Retorno Tejón, Supermanzana 20.",
  },
  {
    question: "¿Cómo pago?",
    answer:
      "Aceptamos transferencia bancaria, depósito en efectivo, tarjeta de débito y crédito (con pequeño cargo bancario). Para producciones grandes pedimos 50% de anticipo y 50% al entregar. Para trabajos pequeños el pago es completo al confirmar.",
  },
  {
    question: "¿Cómo te cobramos? ¿Cómo calculan el precio?",
    answer:
      'Cobramos por lo que realmente lleva tu pieza: el material que usa y el tiempo que tarda la máquina, más manejo e IVA. Sin precios inflados, y en volumen el costo por pieza baja. Puedes ver el desglose completo en la sección "¿Cómo calculamos tu precio?" y descargar la guía paso a paso en PDF: <a href="https://lumocancun.com/como-cotizamos-corte-laser.pdf" target="_blank" rel="noopener noreferrer">¿Cómo te cobramos? (PDF)</a>.',
  },
  {
    question: "¿Para qué tipo de negocios cortan y graban en serie?",
    answer:
      "Para negocios que necesitan la misma pieza muchas veces y que vuelven a pedirla. Hoteles y restaurantes: posavasos, menús, llaveros de habitación, señalética y amenidades grabadas con su marca, en lotes y con reposición. Marcas y corporativos: regalos corporativos, placas, reconocimientos, kits de bienvenida y displays con el logo de la empresa, por cientos. Tiendas de souvenirs y mayoreo: llaveros, imanes y recuerdos de Cancún por lote para tiendas, hoteles y revendedores. Eventos y bodas: números de mesa, recuerdos, señalética y decoración para eventos de cientos de invitados, iguales pieza a pieza. Retail y señalética: señalética interior, displays, exhibidores y lettering volumétrico para sucursales y puntos de venta. Líneas de producto: si vendes un producto cortado o grabado, lo fabricamos en serie, como cajas, empaques, kits y piezas de línea.",
  },
  {
    question: "¿Pueden combinar corte láser e impresión 3D en un mismo pedido?",
    answer:
      "Sí. Muchos pedidos combinan las dos técnicas: un llavero de acrílico con una pieza impresa, o un display con partes cortadas y partes impresas. Cotizamos todo el lote en una sola conversación.",
  },
];

---

<Base
  title={`${service.name} en serie en Cancún | Lumo Cancún`}
  description={service.metaDescription}
  canonical={service.slug}
  ogImage="/og/corte-laser.jpg"
  schemaType="Service"
  schemaData={serviceSchema}
>
  <Nav variant="solid" />
  <main>
    <Breadcrumb
      items={[
        { label: "Inicio", href: "/" },
        { label: "Servicios", href: "/#servicios" },
        { label: service.name },
      ]}
    />

    <ServicePageHero
      eyebrow="Producción en serie"
      title="Corte láser en serie en <em>Cancún</em>"
      subtitle="Cortamos y grabamos en serie para hoteles, restaurantes, marcas, tiendas y eventos. Lotes de decenas a miles de piezas idénticas, con precio por volumen."
      primaryCta={{ label: "Cotiza tu producción", href: "#cotiza" }}
      secondaryCta={{ label: "Ver materiales", href: "#materiales" }}
      service="laser"
    >
      <LaserShowcase slot="showcase" />
    </ServicePageHero>

    <ServicePdfs service={service} />

    <LaserAssembly />

    <Materials />

    <Gallery
      filterService="corte-laser"
      title="Trabajos de corte láser"
      subtitle="Una selección del taller — productos terminados, lifestyle y trabajos a escala industrial."
    />

    <PricingFormula serviceId="corte-laser" preciosPdf={service.preciosPdf} />

    <PriceTable serviceId="corte-laser" />

    <FAQ
      title="Preguntas frecuentes sobre corte láser"
      subtitle="Las dudas que nos hacen más seguido. Si la tuya no aparece, mándanos un WhatsApp."
      items={faqs}
      downloadCta={{ href: "/como-cotizamos-corte-laser.pdf", label: "¿Cómo te cobramos? (PDF)" }}
    />

    <ServiceLinks
      excludeId="corte-laser"
      guide={{ href: "/recursos/preparar-archivo-corte-laser/", label: "Guía: cómo preparar tu archivo" }}
    />

    <QuoteForm defaultService="corte-laser" />
  </main>
  <div class="page-end">
    <Contact />
    <Footer />
  </div>
  <WhatsAppButton />
</Base>

