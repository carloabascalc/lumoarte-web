{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cortelasercancun.com" }],
      "destination": "/cortelasercancun"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.cortelasercancun.com" }],
      "destination": "/cortelasercancun"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "impresion3dcancun.com" }],
      "destination": "/impresion3dcancun"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.impresion3dcancun.com" }],
      "destination": "/impresion3dcancun"
    }
  ],
  "redirects": [
    { "source": "/(contacto|buzon-de-quejas-y-sugerencias){/}?", "destination": "/#cotiza", "permanent": true },
    { "source": "/preguntas-frecuentes{/}?", "destination": "/#faq", "permanent": true },
    { "source": "/(galeria|galeria-corte-laser-artistico){/}?", "destination": "/servicios/corte-laser/#galeria", "permanent": true },
    { "source": "/materiales-corte-laser-artistico{/}?", "destination": "/servicios/corte-laser/#materiales", "permanent": true },
    { "source": "/servicios-corte-laser-artistico{/}?", "destination": "/servicios/corte-laser/", "permanent": true },
    { "source": "/(politicas-de-privacidad|terminos-y-condiciones){/}?", "destination": "/aviso-de-privacidad/", "permanent": true },
    { "source": "/proximamente{/}?", "destination": "/", "permanent": true },
    { "source": "/(blog|decoracion|arte-decorativo|category|tag|author)/:path*{/}?", "destination": "/recursos/", "permanent": true },
    { "source": "/servicios/impresion-gran-formato", "destination": "/", "permanent": true },
    { "source": "/servicios/impresion-gran-formato/", "destination": "/", "permanent": true },
    { "source": "/precios-impresion-gran-formato.pdf", "destination": "/", "permanent": true },
    { "source": "/manual-impresion-gran-formato.pdf", "destination": "/", "permanent": true },
    { "source": "/precios-lumoarte.pdf", "destination": "/precios-corte-laser.pdf", "permanent": true },
    { "source": "/manual-lumoarte.pdf", "destination": "/manual-corte-laser.pdf", "permanent": true },
    {
      "source": "/cortelasercancun",
      "has": [{ "type": "host", "value": "lumocancun.com" }],
      "destination": "/servicios/corte-laser/",
      "permanent": true
    },
    {
      "source": "/cortelasercancun/",
      "has": [{ "type": "host", "value": "lumocancun.com" }],
      "destination": "/servicios/corte-laser/",
      "permanent": true
    },
    {
      "source": "/cortelasercancun",
      "has": [{ "type": "host", "value": "www.lumocancun.com" }],
      "destination": "/servicios/corte-laser/",
      "permanent": true
    },
    {
      "source": "/cortelasercancun/",
      "has": [{ "type": "host", "value": "www.lumocancun.com" }],
      "destination": "/servicios/corte-laser/",
      "permanent": true
    },
    {
      "source": "/impresion3dcancun",
      "has": [{ "type": "host", "value": "lumocancun.com" }],
      "destination": "/servicios/impresion-3d/",
      "permanent": true
    },
    {
      "source": "/impresion3dcancun/",
      "has": [{ "type": "host", "value": "lumocancun.com" }],
      "destination": "/servicios/impresion-3d/",
      "permanent": true
    },
    {
      "source": "/impresion3dcancun",
      "has": [{ "type": "host", "value": "www.lumocancun.com" }],
      "destination": "/servicios/impresion-3d/",
      "permanent": true
    },
    {
      "source": "/impresion3dcancun/",
      "has": [{ "type": "host", "value": "www.lumocancun.com" }],
      "destination": "/servicios/impresion-3d/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https://www.google.com https://www.instagram.com https://www.facebook.com; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap-(.*).xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
